# Copy to .env (or set these in your web server / systemd unit) and fill in.
# Never commit real values.

# Database (DB_PASSWORD is required; the app refuses to start without it)
DB_HOST=localhost
DB_NAME=ethicalbuy
DB_USER=ethicalbuy
DB_PASSWORD=

# Public base URL, used to build redirects
SITE_URL=https://ethicalbuy.duckdns.org

# Set to 1 for local development only. Never 1 in production:
# it renders PHP errors, including SQL and file paths, to visitors.
APP_DEBUG=0

# Admin area (/admin), protected by HTTP Basic auth.
# Leave both blank to keep /admin disabled: it fails closed and returns 500.
# Generate the hash with:  php dev/admin-password.php 'your password'
# Store the hash only. Never put the plaintext password here.
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Set to 1 only when a reverse proxy in front of this app sets
# X-Forwarded-Proto. Any client can forge that header otherwise, which would
# let them claim an insecure request was HTTPS.
TRUST_PROXY=0
