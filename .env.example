# Copy to .env (or set these in your web server / systemd unit) and fill in.
# Never commit real values.

# Database (DB_PASSWORD is required; the app refuses to start without it)
DB_HOST=localhost
DB_NAME=ethicalbuy
DB_USER=ethicalbuy
DB_PASSWORD=

# Public base URL, used to build redirects
SITE_URL=https://ethicalbuy.net

# Set to 1 for local development only. Never 1 in production:
# it renders PHP errors, including SQL and file paths, to visitors.
APP_DEBUG=0

# Admin area (/admin), protected by HTTP Basic auth.
# Leave both blank to keep /admin disabled: it fails closed and returns 500.
# Generate the hash with:  php dev/admin-password.php 'your password'
# Store the hash only. Never put the plaintext password here.
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Set to 1 behind the Cloudflare tunnel. CF-Connecting-IP and
# X-Forwarded-Proto are then believed, but only from a loopback peer;
# from anywhere else any client could forge them.
TRUST_PROXY=0

# Everything below is described in docs/public-deployment.md.

# Behind the Cloudflare tunnel: set TRUST_PROXY=1 above.
# Host names where /admin exists; empty means anywhere (local development).
ADMIN_ALLOWED_HOSTS=

# 0 = soft launch: noindex everywhere, robots.txt disallows all.
SITE_INDEXABLE=0

# Named in the privacy policy and terms. Placeholders show until set.
CONTROLLER_NAME=
CONTACT_EMAIL=

# Days to keep contact messages and log rows (bin/purge-messages.php).
MESSAGE_RETENTION_DAYS=180

# Optional Cloudflare Turnstile on the contact form; used only if both set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional: key for hashing IP addresses in rate limit counters.
IP_HASH_KEY=

# Limits (defaults shown)
RATE_BROWSE_PER_MINUTE=120
RATE_CONTACT_PER_HOUR=3
RATE_CONTACT_PER_DAY=10
CONTACT_MIN_SECONDS=3
ADMIN_AUTH_MAX_FAILURES=5
ADMIN_AUTH_WINDOW_MINUTES=15
ADMIN_AUTH_LOCK_MINUTES=15
DB_STATEMENT_TIMEOUT=5

# Where sitemaps are cached; default is the system temp directory.
CACHE_DIR=

# Reserved for advertising. Leave at 0.
ADS_ENABLED=0
